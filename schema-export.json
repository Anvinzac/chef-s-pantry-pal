    "relationships": {
      "description": "Entity relationships and data flow in the system. Note: There is NO direct relationship between ingredients and dishes. Ingredients are for inventory/ordering; dishes are a separate menu catalog.",
      "ingredientBelongsTo": ["Category"],
      "ingredientHasMany": ["OrderItems", "StockReports", "StockRemaining"],
      "ingredientHas": ["ReferencePrice"],
      "orderHasMany": ["OrderItems"],
      "orderItemReferences": ["Ingredient (by ingredientId)"],
      "orderItemBelongsTo": ["Order"],
      "categoryHasMany": ["Ingredients", "Subcategories (optional)", "Recommendations"],
      "categoryHas": ["CategorySettings (delivery offset)"],
      "dailyMenuBelongsTo": ["Branch", "Restaurant (Supabase only)"],
      "dailyMenuContains": ["Array of selected dish IDs (stored as JSON/JSONB)"],
      "menuDishBelongsTo": ["MenuCategory"],
      "restaurantHasMany": ["Branches", "Orders", "MenuDishes", "UserRoles"],
      "branchBelongsTo": ["Restaurant"],
      "branchHasMany": ["DailyMenus"],
      "templateHasMany": ["TemplateCategories", "InferenceRules"],
      "appInstanceHas": ["Template (via templateId)", "Settings"],
      "appInstanceHasMany": ["Members"],
      "dataFlow": [
        "1. Chefs select dishes from menu_dishes catalog for daily menus",
        "2. Ingredients are ordered based on kitchen needs (not directly derived from dish recipes)",
        "3. Stock levels are tracked per ingredient",
        "4. Recommendations are generated based on order frequency and last purchase date",
        "5. Special days (holidays, lunar events) influence ordering impact"
      ]
    },

    "idNamingConvention": {
      "description": "Ingredient ID prefix patterns used in the catalog",
      "prefixes": {
        "v1-v42": "Vegetables (root-vegetables, leafy-greens, allium-vegetables, stem-vegetables subcategories)",
        "s1-s20": "Sauces",
        "sp1-sp20": "Spices",
        "g1-g15": "Grains",
        "o1-o10": "Oils",
        "p1-p10": "Proteins",
        "d1-d8": "Dairy",
        "ga1-ga5": "Gas",
        "e1-e10": "Equipment",
        "t1-t10": "Tissue & Cleaning"
      },
      "dishIdPattern": "{category}-{number} (e.g., boiled-1, stew-3, fried-2)"
    },

    "databaseSchema": {
      "description": "Database table schemas for reference",
      "turso": {
        "type": "SQLite (Turso)",
        "tables": {
          "users": ["id", "name", "role (default: chef)", "created_at"],
          "ingredients": ["id", "name", "emoji", "unit", "category", "subcategory", "reference_price", "supplier", "quick_quantities (JSON)", "last_ordered_quantity", "last_order_date", "order_frequency_days", "next_reminder", "updated_at"],
          "orders": ["id", "order_date", "total_cost_k", "notes", "created_at"],
          "order_items": ["id", "order_id (FK->orders)", "ingredient_id", "name", "category", "subcategory", "quantity", "unit", "cost_k", "reference_price", "supplier", "emoji", "created_at"],
          "stock_reports": ["id", "ingredient_id", "name", "emoji", "category", "subcategory", "unit", "reported_at", "resolved_at"],
          "stock_remaining": ["id", "ingredient_id", "name", "emoji", "category", "subcategory", "unit", "remaining_quantity", "reported_at"],
          "daily_menus": ["id (autoincrement)", "menu_date", "branch_id (default: pnt)", "dishes (JSON)", "created_at", "UNIQUE(menu_date, branch_id)"],
          "menu_dishes": ["id", "name", "category", "sort_order", "created_at"],
          "inventory": ["id", "space_id", "code", "name", "quantity", "unit", "note", "supplier", "sub_type", "updated_at"]
        }
      },
      "supabase": {
        "type": "PostgreSQL (Supabase)",
        "tables": {
          "restaurants": ["id", "name", "slug", "created_at"],
          "branches": ["id", "name", "sort_order", "restaurant_id (FK->restaurants)", "created_at"],
          "profiles": ["id", "user_id (FK->auth.users)", "display_name", "created_at"],
          "user_roles": ["id", "user_id (FK->auth.users)", "role (app_role enum)", "restaurant_id (FK->restaurants)"],
          "orders": ["id", "order_date", "total_cost_k", "notes", "restaurant_id (FK->restaurants)", "created_at"],
          "order_items": ["id", "order_id (FK->orders)", "ingredient_id", "name", "category", "quantity", "unit", "cost_k", "restaurant_id (FK->restaurants)", "created_at"],
          "stock_reports": ["id", "ingredient_id", "name", "emoji", "category", "subcategory", "unit", "reported_at", "resolved_at", "restaurant_id (FK->restaurants)"],
          "stock_remaining": ["id", "ingredient_id", "name", "emoji", "category", "subcategory", "unit", "remaining_quantity", "reported_by (FK->auth.users)", "reported_at", "restaurant_id (FK->restaurants)"],
          "daily_menus": ["id", "menu_date", "branch_id", "dishes (JSONB)", "restaurant_id (FK->restaurants)", "created_at", "updated_at"],
          "menu_dishes": ["id", "name", "category", "sort_order", "restaurant_id (FK->restaurants)", "created_at"]
        },
        "enums": {
          "app_role": ["chef", "kitchen_member"]
        }
      }
    }
  }
}
