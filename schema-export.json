{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChefsPantryPalDataSchema",
  "description": "Complete data schema export for Chef's Pantry Pal - a Vietnamese restaurant kitchen inventory and ordering system. Includes types from ingredients to dishes.",
  "version": "1.0.0",
  "exportDate": "2026-05-06",

  "$defs": {
    "typeDefinitions": {
      "Ingredient": {
        "type": "object",
        "required": ["id", "name", "emoji", "unit", "category", "quickQuantities"],
        "properties": {
          "id": { "type": "string", "description": "Stable catalog identifier (e.g., v1, s3, p7)" },
          "name": { "type": "string", "description": "Human-readable ingredient name in Vietnamese" },
          "emoji": { "type": "string", "description": "Visual marker used in the UI" },
          "unit": { "$ref": "#/$defs/enums/UnitOfMeasurement" },
          "category": { "$ref": "#/$defs/enums/IngredientCategory" },
          "subcategory": { "type": "string", "description": "Optional subcategory (e.g., root-vegetables, leafy-greens, allium-vegetables, stem-vegetables)" },
          "referencePrice": { "type": "number", "description": "Reference purchase price in thousands VND" },
          "supplier": { "type": "string" },
          "quickQuantities": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2,
            "description": "Two quick-pick quantities used by the ordering UI"
          },
          "lastOrderedQuantity": { "type": "number" },
          "lastOrderDate": { "type": "string", "format": "date" },
          "orderFrequencyDays": { "type": "integer", "minimum": 0 },
          "nextReminder": { "type": "string", "format": "date-time" }
        }
      },
      "EnhancedIngredient": {
        "allOf": [
          { "$ref": "#/$defs/typeDefinitions/Ingredient" },
          {
            "type": "object",
            "required": ["metadata", "createdAt", "updatedAt"],
            "properties": {
              "exception": { "type": "string" },
              "metadata": { "type": "object" },
              "templateId": { "type": "string" },
              "inferredData": { "$ref": "#/$defs/typeDefinitions/InferredData" },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "InferredData": {
        "type": "object",
        "properties": {
          "unit": { "type": "string" },
          "category": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "enum": ["template", "prediction", "user"] }
        }
      },
      "Entry": {
        "type": "object",
        "required": ["id", "name", "quantity", "unit", "category", "metadata", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "category": { "type": "string" },
          "exception": { "type": "string" },
          "metadata": { "type": "object" },
          "templateId": { "type": "string" },
          "inferredData": { "$ref": "#/$defs/typeDefinitions/InferredData" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": ["ingredientId", "name", "quantity", "unit", "timestamp", "category"],
        "properties": {
          "ingredientId": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "$ref": "#/$defs/enums/UnitOfMeasurement" },
          "timestamp": { "type": "string", "format": "date-time" },
          "category": { "$ref": "#/$defs/enums/IngredientCategory" },
          "subcategory": { "type": "string" },
          "referencePrice": { "type": "number" },
          "supplier": { "type": "string" },
          "emoji": { "type": "string" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "name", "emoji", "color"],
        "properties": {
          "id": { "$ref": "#/$defs/enums/IngredientCategory" },
          "name": { "type": "string", "description": "Vietnamese display name" },
          "emoji": { "type": "string" },
          "color": { "type": "string", "description": "HSL color string for UI theming" },
          "subcategories": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/Subcategory" }
          }
        }
      },
      "Subcategory": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "description": "Vietnamese display name" },
          "emoji": { "type": "string" }
        }
      },
      "PriceEntry": {
        "type": "object",
        "required": ["priceK"],
        "properties": {
          "priceK": { "type": "number", "description": "Price in thousands VND (e.g., 30 = 30,000 VND)" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "description": "Price source (e.g., market)" }
        }
      },
      "MenuDish": {
        "type": "object",
        "required": ["id", "name", "category"],
        "properties": {
          "id": { "type": "string", "description": "Dish identifier (e.g., boiled-1, stew-3)" },
          "name": { "type": "string", "description": "Vietnamese dish name" },
          "category": { "$ref": "#/$defs/enums/MenuCategory" }
        }
      },
      "MenuCategoryConfig": {
        "type": "object",
        "required": ["id", "name", "vnName", "singleChoice", "dishes"],
        "properties": {
          "id": { "$ref": "#/$defs/enums/MenuCategory" },
          "name": { "type": "string", "description": "English name" },
          "vnName": { "type": "string", "description": "Vietnamese name" },
          "singleChoice": { "type": "boolean", "description": "Whether only one dish can be selected from this category" },
          "dishes": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/MenuDish" }
          }
        }
      },
      "Template": {
        "type": "object",
        "required": ["templateId", "name", "scale", "version", "createdAt", "updatedAt", "categories", "inferenceRules", "metadata"],
        "properties": {
          "templateId": { "type": "string" },
          "name": { "type": "string" },
          "scale": { "type": "string", "enum": ["small", "medium", "enterprise"] },
          "version": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/TemplateCategory" }
          },
          "inferenceRules": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/InferenceRule" }
          },
          "metadata": { "type": "object" }
        }
      },
      "TemplateCategory": {
        "type": "object",
        "required": ["id", "name", "items"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/TemplateItem" }
          },
          "metadata": { "type": "object" }
        }
      },
      "TemplateItem": {
        "type": "object",
        "required": ["id", "name", "defaultUnit", "altUnits", "tags"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "defaultUnit": { "type": "string" },
          "altUnits": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" }
        }
      },
      "InferenceRule": {
        "type": "object",
        "required": ["id", "type", "pattern", "targetField", "replacement", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["fuzzy", "semantic", "regex", "lookup"] },
          "pattern": { "type": "string" },
          "targetField": { "type": "string", "enum": ["unit", "category", "metadata"] },
          "replacement": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "metadata": { "type": "object" }
        }
      },
      "AppInstance": {
        "type": "object",
        "required": ["id", "name", "templateId", "ownerId", "members", "settings", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "templateId": { "type": "string" },
          "ownerId": { "type": "string" },
          "members": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/InstanceMember" }
          },
          "settings": { "$ref": "#/$defs/typeDefinitions/InstanceSettings" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InstanceMember": {
        "type": "object",
        "required": ["userId", "role", "permissions", "joinedAt"],
        "properties": {
          "userId": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "chef", "kitchen_staff", "viewer"] },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "joinedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InstanceSettings": {
        "type": "object",
        "required": ["parentMode", "editMode", "defaultTemplate", "errorCaptureEnabled"],
        "properties": {
          "parentMode": { "type": "boolean" },
          "editMode": { "type": "boolean" },
          "defaultTemplate": { "type": "string" },
          "errorCaptureEnabled": { "type": "boolean" }
        }
      },
      "Recommendation": {
        "type": "object",
        "required": ["ingredient", "lastPurchaseDate", "orderFrequencyDays", "remainingCycle"],
        "properties": {
          "ingredient": { "$ref": "#/$defs/typeDefinitions/Ingredient" },
          "lastPurchaseDate": { "type": "string", "format": "date" },
          "orderFrequencyDays": { "type": "integer", "minimum": 0 },
          "remainingCycle": { "type": "number" },
          "referencePrice": { "type": "number" }
        }
      },
      "RecommendationGroup": {
        "type": "object",
        "required": ["categoryId", "categoryName", "categoryEmoji", "categoryColor", "items"],
        "properties": {
          "categoryId": { "$ref": "#/$defs/enums/IngredientCategory" },
          "categoryName": { "type": "string" },
          "categoryEmoji": { "type": "string" },
          "categoryColor": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/typeDefinitions/Recommendation" }
          }
        }
      },
      "DayWeightEntry": {
        "type": "object",
        "required": ["date", "categoryId", "weight"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "categoryId": { "$ref": "#/$defs/enums/IngredientCategory" },
          "weight": { "type": "number" }
        }
      },
      "CategorySetting": {
        "type": "object",
        "required": ["categoryId", "deliveryOffset"],
        "properties": {
          "categoryId": { "$ref": "#/$defs/enums/IngredientCategory" },
          "deliveryOffset": { "type": "integer", "description": "Days before delivery to generate recommendation" }
        }
      },
      "SpecialDay": {
        "type": "object",
        "required": ["date", "label", "emoji", "impact"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "label": { "type": "string", "description": "Vietnamese holiday/event name" },
          "emoji": { "type": "string" },
          "impact": { "type": "string", "enum": ["high", "medium", "low"], "description": "Impact on ingredient ordering" }
        }
      },
      "DailyMenu": {
        "type": "object",
        "description": "Represents a daily menu for a specific branch/restaurant",
        "required": ["menuDate", "branchId", "dishes"],
        "properties": {
          "menuDate": { "type": "string", "format": "date" },
          "branchId": { "type": "string", "description": "Branch identifier (e.g., pnt)" },
          "dishes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of dish IDs selected for this day"
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StockReport": {
        "type": "object",
        "description": "Out-of-stock report for an ingredient",
        "required": ["ingredientId", "name", "emoji", "category", "unit", "reportedAt"],
        "properties": {
          "ingredientId": { "type": "string" },
          "name": { "type": "string" },
          "emoji": { "type": "string" },
          "category": { "$ref": "#/$defs/enums/IngredientCategory" },
          "subcategory": { "type": "string" },
          "unit": { "$ref": "#/$defs/enums/UnitOfMeasurement" },
          "reportedAt": { "type": "string", "format": "date-time" },
          "resolvedAt": { "type": "string", "format": "date-time" }
        }
      },
      "StockRemaining": {
        "type": "object",
        "description": "Current remaining stock level for an ingredient",
        "required": ["ingredientId", "name", "emoji", "category", "unit", "remainingQuantity", "reportedAt"],
        "properties": {
          "ingredientId": { "type": "string" },
          "name": { "type": "string" },
          "emoji": { "type": "string" },
          "category": { "$ref": "#/$defs/enums/IngredientCategory" },
          "subcategory": { "type": "string" },
          "unit": { "$ref": "#/$defs/enums/UnitOfMeasurement" },
          "remainingQuantity": { "type": "number" },
          "reportedAt": { "type": "string", "format": "date-time" }
        }
      }
    },

    "enums": {
      "UnitOfMeasurement": {
        "type": "string",
        "enum": ["kg", "g", "lít", "ml", "cái", "gói", "chai", "hộp", "bịch", "lon", "cuộn", "tá", "bình", "đôi"],
        "description": "Units of measurement for ingredients"
      },
      "UnitLabels": {
        "type": "object",
        "description": "Vietnamese labels for each unit",
        "properties": {
          "kg": { "const": "kg" },
          "g": { "const": "g" },
          "lít": { "const": "lít" },
          "ml": { "const": "ml" },
          "cái": { "const": "cái" },
          "gói": { "const": "gói" },
          "chai": { "const": "chai" },
          "hộp": { "const": "hộp" },
          "bịch": { "const": "bịch" },
          "lon": { "const": "lon" },
          "cuộn": { "const": "cuộn" },
          "tá": { "const": "tá" },
          "bình": { "const": "bình" },
          "đôi": { "const": "đôi" }
        }
      },
      "IngredientCategory": {
        "type": "string",
        "enum": ["vegetables", "sauces", "spices", "grains", "oils", "tofu", "proteins", "dairy", "gas", "equipment", "tissue"],
        "description": "Ingredient category identifiers"
      },
      "MenuCategory": {
        "type": "string",
        "enum": ["boiled", "stew", "fried", "soup", "hotpot", "sweet_soup", "mixed_noodle", "mixed_veg", "stir_fry"],
        "description": "Cooking method categories for menu dishes"
      },
      "AppRole": {
        "type": "string",
        "enum": ["chef", "kitchen_member"],
        "description": "Supabase database roles"
      },
      "InstanceRole": {
        "type": "string",
        "enum": ["admin", "chef", "kitchen_staff", "viewer"],
        "description": "App instance member roles"
      },
      "TemplateScale": {
        "type": "string",
        "enum": ["small", "medium", "enterprise"],
        "description": "Template scale for different restaurant sizes"
      },
      "InferenceRuleType": {
        "type": "string",
        "enum": ["fuzzy", "semantic", "regex", "lookup"],
        "description": "Types of inference rules for template matching"
      },
      "SpecialDayImpact": {
        "type": "string",
        "enum": ["high", "medium", "low"],
        "description": "Impact level of special days on ordering"
      }
    },

